---
import Base from "../layouts/Base.astro";
---

<Base lang="en" path="/" title="Page not found" description="This page doesn't exist.">
  <section class="section container" style="text-align:center">
    <h1>Page not found</h1>
    <p class="muted">The page you're looking for doesn't exist or has moved.</p>
    <p class="muted" lang="fa" dir="rtl">صفحه‌ای که دنبالش هستید پیدا نشد.</p>
    <div class="btn-row" style="justify-content:center">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/fa/" lang="fa">صفحهٔ اصلی</a>
    </div>
  </section>
</Base>
