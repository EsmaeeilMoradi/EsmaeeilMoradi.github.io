---
import ChallengeDay from "../../../components/ChallengeDay.astro";
import { getDays } from "../../../lib/challenge";
export function getStaticPaths() {
  return getDays("en", "2025").map((d) => ({ params: { day: d.slug } }));
}
const { day } = Astro.params;
---

<ChallengeDay lang="en" slug={day!} edition="2025" />
