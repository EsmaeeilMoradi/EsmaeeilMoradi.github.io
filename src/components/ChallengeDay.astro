---
import Base from "../layouts/Base.astro";
import { links, t, href, type Lang } from "../data/site";
import { getDays, num } from "../lib/challenge";

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const days = getDays(lang);
const i = days.findIndex((d) => d.slug === slug);
const day = days[i];
const prev = days[i - 1];
const next = days[i + 1];
const L = {
  back: { en: "All 30 days", fa: "همهٔ ۳۰ روز" },
  day: { en: "Day", fa: "روز" },
  edition: { en: "2025 Edition", fa: "نسخهٔ ۲۰۲۵" },
  open: { en: "Open the carousel (PDF)", fa: "باز کردن کاروسل (PDF)" },
  slides: { en: "slides · English", fa: "اسلاید، انگلیسی" },
  levelsT: { en: "Inside this day", fa: "در این روز" },
  levels: {
    en: "Questions and detailed answers at four levels — Junior, Mid, Senior and Architect — with code samples and architect's insights.",
    fa: "سؤال و جواب مفصل در چهار سطح — جونیور، مید، سینیور و آرکیتکت — همراه با نمونه‌کد و نکته‌های آرکیتکت.",
  },
  how: {
    en: "Try answering each question out loud before you read the answer — that's the closest thing to a real interview.",
    fa: "قبل از خواندن هر جواب، سعی کنید سؤال را با صدای بلند جواب بدهید — این نزدیک‌ترین تمرین به مصاحبهٔ واقعی است.",
  },
  faNote: {
    en: "",
    fa: "این نسخه به انگلیسی است. نسخهٔ فارسی ۲۰۲۶ در لینکدین منتشر می‌شود.",
  },
  prev: { en: "Previous", fa: "قبلی" },
  next: { en: "Next", fa: "بعدی" },
  mentor: {
    en: "Preparing for a senior Android interview? I run mock interviews in English and Persian.",
    fa: "برای مصاحبهٔ سینیور اندروید آماده می‌شوید؟ مصاحبهٔ آزمایشی به فارسی و انگلیسی برگزار می‌کنم.",
  },
  mentorCta: { en: "Get in touch", fa: "در تماس باشیم" },
};
const heading = `${t(L.day, lang)} ${num(day.n, lang)} — ${day.title}`;
---

<Base lang={lang} path={`/challenge/${slug}/`} title={heading} description={day.description} image={day.cover}>
  <article class="section container layout">
    <div class="text">
      <a class="back" href={href("/challenge/", lang)}>{t(L.back, lang)}</a>
      <p class="eyebrow">{t(L.day, lang)} {num(day.n, lang)} / {num(30, lang)}{lang === "fa" ? "، " : " · "}{t(L.edition, lang)}</p>
      <h1>{day.title}</h1>
      {lang === "fa" && <p class="en-title ltr">{day.titleEn}</p>}
      <p class="lead">{day.description}</p>
      <h2>{t(L.levelsT, lang)}</h2>
      <p class="muted">{t(L.levels, lang)}</p>
      <p class="muted">{t(L.how, lang)}</p>
      {t(L.faNote, lang) && <p class="fa-note">{t(L.faNote, lang)} <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>}
      <div class="btn-row cta">
        <a class="btn btn-primary" href={day.pdf} target="_blank" rel="noopener">{t(L.open, lang)}</a>
      </div>
      <p class="muted meta">{num(day.slides, lang)} {t(L.slides, lang)}</p>
      <nav class="pager">
        {prev ? <a href={href(`/challenge/${prev.slug}/`, lang)}><small>{t(L.prev, lang)}</small>{prev.title}</a> : <span />}
        {next ? <a class="next" href={href(`/challenge/${next.slug}/`, lang)}><small>{t(L.next, lang)}</small>{next.title}</a> : <span />}
      </nav>
    </div>
    <aside class="side">
      <a href={day.pdf} target="_blank" rel="noopener">
        <img src={day.cover} alt={heading} width="480" height="600" />
      </a>
      <div class="card mentor">
        <p>{t(L.mentor, lang)}</p>
        <a class="arrow" href={href("/#contact", lang)}>{t(L.mentorCta, lang)} </a>
      </div>
    </aside>
  </article>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }
  .back {
    display: block;
    width: fit-content;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
  }
  h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
  }
  .en-title {
    color: var(--muted);
    margin-top: -0.5rem;
  }
  .lead {
    font-size: 1.15rem;
  }
  .fa-note {
    font-size: 0.95rem;
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: 1rem;
  }
  .cta {
    margin-top: 1.75rem;
  }
  .meta {
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }
  .side {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .side img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .mentor {
    padding: 1.25rem;
    font-size: 0.95rem;
  }
  .mentor p {
    margin-bottom: 0.5rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .pager small {
    color: var(--muted);
    font-weight: 400;
  }
  .pager .next {
    text-align: end;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
    .side > a:first-child {
      display: none;
    }
  }
</style>
