---
import Base from "../layouts/Base.astro";
import { links, t, href, type Lang } from "../data/site";
import { getArticles, series } from "../lib/articles";
import { num } from "../lib/challenge";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const articles = getArticles(lang);
const L = {
  eyebrow: { en: "Writing · English", fa: "نوشته‌ها، انگلیسی" },
  title: { en: "Articles", fa: "مقاله‌ها" },
  lead: {
    en: "Carousel articles I first published on LinkedIn — on architecture, the business cost of technical decisions, and how Android works under the hood.",
    fa: "مقاله‌های کاروسلی که اول در لینکدین منتشر کردم — دربارهٔ معماری، هزینهٔ تجاری تصمیم‌های فنی، و اینکه اندروید زیر پوسته چطور کار می‌کند.",
  },
  follow: { en: "Follow on LinkedIn", fa: "دنبال کردن در لینکدین" },
  slides: { en: "slides", fa: "اسلاید" },
};
---

<Base lang={lang} path="/articles/" title={t(L.title, lang)} description={t(L.lead, lang)} image={articles[0].cover}>
  <section class="section container">
    <div class="section-head wide">
      <span class="eyebrow">{t(L.eyebrow, lang)}</span>
      <h1>{t(L.title, lang)}</h1>
      <p>{t(L.lead, lang)}</p>
      <a href={links.linkedin} target="_blank" rel="noopener" class="arrow">{t(L.follow, lang)} </a>
    </div>

    {
      series.map((s) => (
        <section class="group">
          <h2>{t(s.title, lang)}</h2>
          <p class="muted desc">{t(s.description, lang)}</p>
          <div class="cards">
            {articles
              .filter((a) => a.series === s.id)
              .map((a) => (
                <a class="article" href={href(`/articles/${a.slug}/`, lang)}>
                  <span class="thumb">
                    <img src={a.cover} alt="" loading="lazy" width="480" height="600" />
                  </span>
                  <span class="meta">
                    {a.dateLabel}{lang === "fa" ? "، " : " · "}{num(a.slides, lang)} {t(L.slides, lang)}
                  </span>
                  <span class="title">{a.title}</span>
                </a>
              ))}
          </div>
        </section>
      ))
    }
  </section>
</Base>

<style>
  .wide {
    max-width: 820px;
  }
  .wide .arrow {
    font-weight: 600;
  }
  .group {
    margin-top: 3rem;
  }
  .group h2 {
    font-size: 1.4rem;
  }
  .desc {
    margin: 0.25rem 0 1.25rem;
    max-width: 720px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1.5rem;
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--text);
  }
  .thumb {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border);
    margin-bottom: 0.4rem;
    background: var(--surface-2);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }
  .article:hover img {
    transform: scale(1.03);
  }
  .article:hover .title {
    color: var(--accent);
  }
  .meta {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.4;
  }
</style>
