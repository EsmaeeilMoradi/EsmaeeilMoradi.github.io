---
import Base from "../layouts/Base.astro";
import { t, href, type Lang } from "../data/site";
import {
  roadmapMeta,
  mainStages,
  deepStages,
  legacyStages,
  specialStages,
  type RoadmapStage,
} from "../data/android-roadmap-2026";
import { stageOfficialDocs } from "../data/android-roadmap-docs";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const meta = roadmapMeta;

type Packed = {
  id: string;
  number: number;
  track: string;
  essential: boolean;
  title: string;
  titleEn: string;
  titleFa: string;
  subtitle: string;
  prerequisite: string;
  goal: string;
  concepts: { id: string; label: string; labelEn: string; labelFa: string }[];
  tools: { recommended: string[]; alternatives: string[] };
  exercise: string;
  passCriteria: string;
  docs: { label: string; url: string }[];
};

function pack(list: RoadmapStage[], essential: boolean): Packed[] {
  return list.map((s) => ({
    id: s.id,
    number: s.number,
    track: s.track,
    essential,
    title: t(s.title, lang),
    titleEn: s.title.en,
    titleFa: s.title.fa,
    subtitle: t(s.subtitle, lang),
    prerequisite: t(s.prerequisite, lang),
    goal: t(s.goal, lang),
    concepts: s.concepts.map((c, i) => ({
      id: `${s.id}__c${i}`,
      label: t(c, lang),
      labelEn: c.en,
      labelFa: c.fa,
    })),
    tools: {
      recommended: s.tools.recommended.map((x) => t(x, lang)),
      alternatives: s.tools.alternatives.map((x) => t(x, lang)),
    },
    exercise: t(s.exercise, lang),
    passCriteria: t(s.passCriteria, lang),
    docs: (stageOfficialDocs[s.id] || s.docs || []).map((d) => ({
      label: t(d.label, lang),
      url: d.url,
    })),
  }));
}

const stagesPayload = {
  main: pack(mainStages, true),
  deep: pack(deepStages, false),
  legacy: pack(legacyStages, false),
  special: pack(specialStages, false),
};

const trackSections = [
  { key: "main", stages: stagesPayload.main, title: t(meta.trackMain, lang), desc: t(meta.trackMainDesc, lang), kind: "main" as const },
  { key: "deep", stages: stagesPayload.deep, title: t(meta.trackDeep, lang), desc: t(meta.trackDeepDesc, lang), kind: "optional" as const },
  { key: "legacy", stages: stagesPayload.legacy, title: t(meta.trackLegacy, lang), desc: t(meta.trackLegacyDesc, lang), kind: "legacy" as const },
  { key: "special", stages: stagesPayload.special, title: t(meta.trackSpecial, lang), desc: t(meta.trackSpecialDesc, lang), kind: "optional" as const },
];

const stagesJson = JSON.stringify(stagesPayload);
const ui = {
  prerequisite: t(meta.prerequisite, lang),
  goal: t(meta.goal, lang),
  concepts: t(meta.concepts, lang),
  tools: t(meta.tools, lang),
  recommended: t(meta.recommended, lang),
  alternatives: t(meta.alternatives, lang),
  exercise: t(meta.exercise, lang),
  passCriteria: t(meta.passCriteria, lang),
  docs: t(meta.docs, lang),
  why: t(meta.why, lang),
  viewMap: t(meta.viewMap, lang),
  viewList: t(meta.viewList, lang),
  searchPlaceholder: t(meta.searchPlaceholder, lang),
  expandAll: t(meta.expandAll, lang),
  collapseAll: t(meta.collapseAll, lang),
  continuePath: t(meta.continuePath, lang),
  markLearning: t(meta.markLearning, lang),
  markDone: t(meta.markDone, lang),
  markDoneTopic: t(meta.markDoneTopic, lang),
  markReview: t(meta.markReview, lang),
  markReset: t(meta.markReset, lang),
  stageStatus: t(meta.stageStatus, lang),
  topicStatus: t(meta.topicStatus, lang),
  closePanel: t(meta.closePanel, lang),
  progressLabel: t(meta.progressLabel, lang),
  remainingLabel: t(meta.remainingLabel, lang),
  statusNone: t(meta.statusNone, lang),
  statusLearning: t(meta.statusLearning, lang),
  statusDone: t(meta.statusDone, lang),
  statusReview: t(meta.statusReview, lang),
  emptyDetail: t(meta.emptyDetail, lang),
  filterAll: t(meta.filterAll, lang),
  filterOpen: t(meta.filterOpen, lang),
  filterDone: t(meta.filterDone, lang),
  levelEssential: t(meta.levelEssential, lang),
  levelOptional: t(meta.levelOptional, lang),
  topicFocus: t(meta.topicFocus, lang),
  checklistHint: t(meta.checklistHint, lang),
  topicsProgress: t(meta.topicsProgress, lang),
  startStage: t(meta.startStage, lang),
  nextAction: t(meta.nextAction, lang),
  trackMain: t(meta.trackMain, lang),
  trackDeep: t(meta.trackDeep, lang),
  trackLegacy: t(meta.trackLegacy, lang),
  trackSpecial: t(meta.trackSpecial, lang),
};
---

<Base lang={lang} path="/android-roadmap-2026/" title={t(meta.title, lang)} description={t(meta.lead, lang)}>
  <section class="container hero">
    <p class="eyebrow">Compose-first · 2026</p>
    <h1>{t(meta.title, lang)}</h1>
    <p class="lead">{t(meta.lead, lang)}</p>
    <p class="note muted">{t(meta.note, lang)}</p>
    <div class="walkthrough">
      <div class="video-frame">
        <iframe
          src={meta.youtubeEmbed}
          title={t(meta.ctaTitle, lang)}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <p class="muted tiny">
        <a href={meta.youtube} target="_blank" rel="noopener">{t(meta.ctaBtn, lang)}</a>
        {" · "}
        <a href={meta.channel} target="_blank" rel="noopener"
          >{lang === "fa" ? "کانال یوتیوب" : "YouTube channel"}</a
        >
      </p>
    </div>
  </section>

  <section class="container map-app" data-roadmap data-lang={lang}>
    <div class="toolbar">
      <div class="view-toggle" role="group" aria-label={ui.viewMap}>
        <button type="button" class="seg active" data-view="map" aria-pressed="true">{ui.viewMap}</button>
        <button type="button" class="seg" data-view="list" aria-pressed="false">{ui.viewList}</button>
      </div>
      <label class="search">
        <span class="sr-only">{ui.searchPlaceholder}</span>
        <input type="search" data-search placeholder={ui.searchPlaceholder} autocomplete="off" />
      </label>
      <div class="toolbar-actions">
        <button type="button" class="btn btn-ghost" data-expand-all>{ui.expandAll}</button>
        <button type="button" class="btn btn-ghost" data-collapse-all>{ui.collapseAll}</button>
        <button type="button" class="btn btn-primary" data-continue>{ui.continuePath}</button>
      </div>
      <div class="progress-box" aria-live="polite">
        <div class="progress-meta">
          <span>{ui.progressLabel}</span>
          <strong data-progress-text>0%</strong>
        </div>
        <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress-bar>
          <span data-progress-fill></span>
        </div>
        <p class="muted tiny"><span data-remaining>0</span> {ui.remainingLabel}</p>
      </div>
    </div>

    <div class="filters" role="group">
      <button type="button" class="chip active" data-filter="all">{ui.filterAll}</button>
      <button type="button" class="chip" data-filter="open">{ui.filterOpen}</button>
      <button type="button" class="chip" data-filter="done">{ui.filterDone}</button>
    </div>

    <aside class="legend" aria-label={t(meta.legendTitle, lang)}>
      <strong>{t(meta.legendTitle, lang)}</strong>
      <span class="leg main">{t(meta.legendMain, lang)}</span>
      <span class="leg alt">{t(meta.legendAlt, lang)}</span>
      <span class="leg legacy">{t(meta.legendLegacy, lang)}</span>
    </aside>

    <div class="workspace">
      <div class="map-pane" data-pane="map">
        {trackSections.map((section) => (
          <section class={`track-block kind-${section.kind}`} data-track-section={section.key}>
            <header class="track-head">
              <h2>{section.title}</h2>
              <p class="muted">{section.desc}</p>
            </header>
            <ol class={`path kind-${section.kind}`}>
              {section.stages.map((stage) => (
                <li class="station" data-station={stage.id} data-essential={stage.essential ? "1" : "0"}>
                  <div class="station-row">
                    <button
                      type="button"
                      class="station-main"
                      data-select-stage={stage.id}
                      aria-expanded="false"
                      aria-controls={`branches-${stage.id}`}
                    >
                      <span class="dot" aria-hidden="true"></span>
                      <span class="station-text">
                        <span class="station-title">{stage.title}</span>
                        <span class="station-sub muted">{stage.subtitle}</span>
                      </span>
                      <span class="status-pill" data-status-for={stage.id}>{ui.statusNone}</span>
                      <span class="chev" aria-hidden="true"></span>
                    </button>
                  </div>
                  <ul class="branches" id={`branches-${stage.id}`} hidden>
                    {stage.concepts.map((c) => (
                      <li class="branch-row">
                        <button type="button" class="branch" data-select-topic={c.id} data-stage={stage.id}>
                          <span class="branch-dot" aria-hidden="true"></span>
                          <span class="branch-label">{c.label}</span>
                          <span class="status-pill tiny-pill" data-status-for={c.id}>{ui.statusNone}</span>
                        </button>
                        <div class="branch-actions" role="group" aria-label={ui.topicStatus}>
                          <button type="button" class="mini-status" data-topic-status={c.id} data-status="learning" title={ui.markLearning}>{ui.markLearning}</button>
                          <button type="button" class="mini-status primary" data-topic-status={c.id} data-status="done" title={ui.markDoneTopic}>{ui.markDoneTopic}</button>
                          <button type="button" class="mini-status" data-topic-status={c.id} data-status="review" title={ui.markReview}>{ui.markReview}</button>
                        </div>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <div class="list-pane" data-pane="list" hidden>
        <ul class="flat-list" data-flat-list></ul>
      </div>

      <aside class="detail" data-detail aria-live="polite">
        <button type="button" class="detail-close btn btn-ghost" data-close-detail hidden>{ui.closePanel}</button>
        <div data-detail-empty class="detail-empty muted">{ui.emptyDetail}</div>
        <div data-detail-body hidden>
          <header class="detail-head">
            <div class="badges">
              <span class="badge" data-d-track></span>
              <span class="badge soft" data-d-level></span>
              <span class="badge status" data-d-status>{ui.statusNone}</span>
            </div>
            <h2 data-d-title></h2>
            <p class="subtitle" data-d-sub></p>
          </header>

          <div class="status-block">
            <p class="status-label">{ui.stageStatus}</p>
            <div class="status-bar" role="group" aria-label={ui.stageStatus}>
              <button type="button" class="status-seg" data-set-status="learning">{ui.markLearning}</button>
              <button type="button" class="status-seg primary" data-set-status="done">{ui.markDone}</button>
              <button type="button" class="status-seg" data-set-status="review">{ui.markReview}</button>
              <button type="button" class="status-seg quiet" data-set-status="none">{ui.markReset}</button>
            </div>
          </div>

          <div class="status-block topic-status-block" data-topic-status-block hidden>
            <p class="status-label"><span data-d-topic-name></span> — {ui.topicStatus}</p>
            <div class="status-bar" role="group" aria-label={ui.topicStatus}>
              <button type="button" class="status-seg" data-set-topic-status="learning">{ui.markLearning}</button>
              <button type="button" class="status-seg primary" data-set-topic-status="done">{ui.markDoneTopic}</button>
              <button type="button" class="status-seg" data-set-topic-status="review">{ui.markReview}</button>
              <button type="button" class="status-seg quiet" data-set-topic-status="none">{ui.markReset}</button>
            </div>
          </div>

          <div class="field hero-goal">
            <h3>{ui.goal}</h3>
            <p data-d-goal></p>
          </div>

          <div class="field">
            <h3>{ui.prerequisite}</h3>
            <p data-d-prereq></p>
          </div>

          <div class="field checklist-field">
            <div class="checklist-head">
              <h3>{ui.concepts}</h3>
              <span class="muted tiny" data-d-topic-count></span>
            </div>
            <p class="muted tiny hint">{ui.checklistHint}</p>
            <ul class="checklist" data-d-concepts></ul>
          </div>

          <div class="field docs-field">
            <h3>{ui.docs}</h3>
            <ul class="doc-links" data-d-docs></ul>
          </div>

          <div class="field exercise">
            <h3>{ui.exercise}</h3>
            <p data-d-exercise></p>
          </div>
          <div class="field pass">
            <h3>{ui.passCriteria}</h3>
            <p data-d-pass></p>
          </div>

          <details class="tools-fold">
            <summary>{ui.tools}</summary>
            <p><span class="label">{ui.recommended}:</span> <span data-d-rec></span></p>
            <p><span class="label">{ui.alternatives}:</span> <span data-d-alt></span></p>
          </details>
        </div>
      </aside>
    </div>

    <aside class="cta card final">
      <h2>{t(meta.finalProjectTitle, lang)}</h2>
      <p class="muted">{t(meta.finalProjectBody, lang)}</p>
    </aside>

    <aside class="cta card">
      <h2>{t(meta.ctaTitle, lang)}</h2>
      <p class="muted">{t(meta.ctaBody, lang)}</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href={meta.youtube} target="_blank" rel="noopener">{t(meta.ctaBtn, lang)}</a>
        <a class="btn btn-ghost" href={meta.channel} target="_blank" rel="noopener"
          >{lang === "fa" ? "کانال" : "Channel"}</a
        >
      </div>
      <p class="muted tiny">
        <a href={href("/challenge/", lang)}>{lang === "fa" ? "چالش ۳۰ روزه" : "30-Day Challenge"}</a>
        {" · "}
        <a href={href("/kotlin-quiz/", lang)}>{lang === "fa" ? "آزمون کاتلین" : "Kotlin Quiz"}</a>
      </p>
    </aside>
  </section>
</Base>

<script define:vars={{ stagesJson, ui }}>
  const STORAGE_KEY = "android-roadmap-2026-progress-v1";
  const tracks = JSON.parse(stagesJson);
  const allStages = [...tracks.main, ...tracks.deep, ...tracks.legacy, ...tracks.special];
  const stageById = Object.fromEntries(allStages.map((s) => [s.id, s]));
  const topicById = {};
  for (const s of allStages) {
    for (const c of s.concepts) topicById[c.id] = { topic: c, stage: s };
  }

  const root = document.querySelector("[data-roadmap]");
  const progressText = root.querySelector("[data-progress-text]");
  const progressBar = root.querySelector("[data-progress-bar]");
  const progressFill = root.querySelector("[data-progress-fill]");
  const remainingEl = root.querySelector("[data-remaining]");
  const detailEmpty = root.querySelector("[data-detail-empty]");
  const detailBody = root.querySelector("[data-detail-body]");
  const closeDetailBtn = root.querySelector("[data-close-detail]");
  const flatList = root.querySelector("[data-flat-list]");
  const searchInput = root.querySelector("[data-search]");

  const trackLabel = {
    main: ui.trackMain,
    deep: ui.trackDeep,
    legacy: ui.trackLegacy,
    special: ui.trackSpecial,
  };

  const statusLabel = {
    none: ui.statusNone,
    learning: ui.statusLearning,
    done: ui.statusDone,
    review: ui.statusReview,
  };

  /** @type {Record<string, 'none'|'learning'|'done'|'review'|true>} */
  let progress = loadProgress();
  let view = "map";
  let filter = "all";
  let activeStageId = null;
  let focusTopicId = null;

  function reducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function loadProgress() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}") || {};
    } catch {
      return {};
    }
  }

  function saveProgress() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
  }

  function getStatus(id) {
    const v = progress[id];
    if (v === true) return "done"; // legacy topic checks
    if (v === "learning" || v === "done" || v === "review") return v;
    return "none";
  }

  function getTopicStatus(topicId) {
    const v = progress[topicId];
    if (v === true || v === "done") return "done";
    if (v === "learning" || v === "review") return v;
    return "none";
  }

  function isTopicChecked(topicId) {
    return getTopicStatus(topicId) === "done";
  }

  function syncStageFromTopics(stage) {
    if (getStatus(stage.id) === "none" && stage.concepts.some((c) => getTopicStatus(c.id) !== "none")) {
      progress[stage.id] = "learning";
    }
    const allDone = stage.concepts.every((c) => isTopicChecked(c.id));
    if (allDone && stage.concepts.length) progress[stage.id] = "done";
    else if (!allDone && getStatus(stage.id) === "done") progress[stage.id] = "learning";
  }

  function setStageStatus(stageId, status) {
    if (!stageId || !stageById[stageId]) return;
    if (status === "none") delete progress[stageId];
    else progress[stageId] = status;
    saveProgress();
    paintStatuses();
    updateProgressMeter();
    applyFilter();
    if (activeStageId === stageId) {
      refreshDetailChrome(stageById[stageId]);
    }
  }

  function setTopicStatus(topicId, status) {
    const hit = topicById[topicId];
    if (!hit) return;
    if (status === "none") delete progress[topicId];
    else progress[topicId] = status;
    syncStageFromTopics(hit.stage);
    saveProgress();
    paintStatuses();
    updateProgressMeter();
    applyFilter();
    focusTopicId = topicId;
    if (activeStageId === hit.stage.id) refreshDetailChrome(hit.stage, topicId);
  }

  function toggleTopicCheck(topicId) {
    setTopicStatus(topicId, isTopicChecked(topicId) ? "none" : "done");
  }

  function updateProgressMeter() {
    const essential = tracks.main;
    const done = essential.filter((s) => getStatus(s.id) === "done").length;
    const pct = essential.length ? Math.round((done / essential.length) * 100) : 0;
    const left = essential.length - done;
    progressText.textContent = `${pct}%`;
    progressBar.setAttribute("aria-valuenow", String(pct));
    if (progressFill) progressFill.style.width = `${pct}%`;
    remainingEl.textContent = String(left);
  }

  function paintStatuses() {
    root.querySelectorAll("[data-status-for]").forEach((el) => {
      const id = el.getAttribute("data-status-for");
      const st = topicById[id] ? getTopicStatus(id) : getStatus(id);
      el.dataset.state = st;
      if (el.classList.contains("status-pill")) el.textContent = statusLabel[st];
    });
    root.querySelectorAll("[data-topic-status]").forEach((btn) => {
      const id = btn.getAttribute("data-topic-status");
      const want = btn.getAttribute("data-status");
      btn.classList.toggle("active", getTopicStatus(id) === want);
    });
    root.querySelectorAll(".station[data-station]").forEach((li) => {
      const id = li.getAttribute("data-station");
      li.dataset.state = getStatus(id);
    });
  }

  function expandStation(id, open) {
    // Prefer map station (list items also use data-station).
    const li =
      root.querySelector(`.station[data-station="${id}"]`) ||
      root.querySelector(`[data-station="${id}"]`);
    if (!li) return;
    const btn = li.querySelector("[data-select-stage]");
    const branches = li.querySelector(".branches");
    if (!btn || !branches) return;
    const willOpen = open ?? !li.classList.contains("open");
    li.classList.toggle("open", willOpen);
    btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
    branches.hidden = !willOpen;
  }

  function selectStage(id, { expand = true, updateHash = true, topicId = null } = {}) {
    activeStageId = id;
    focusTopicId = topicId;
    root.querySelectorAll(".station-main, .branch").forEach((el) => el.classList.remove("active"));
    const btn = root.querySelector(`.map-pane [data-select-stage="${id}"]`) || root.querySelector(`[data-select-stage="${id}"]`);
    if (btn) btn.classList.add("active");
    if (topicId) {
      const tBtn = root.querySelector(`[data-select-topic="${topicId}"]`);
      if (tBtn) tBtn.classList.add("active");
    }
    if (expand) expandStation(id, true);
    renderDetail(stageById[id], topicId);
    if (updateHash) history.replaceState(null, "", `#${topicId || id}`);
    closeDetailBtn.hidden = false;
    if (window.matchMedia("(max-width: 900px)").matches) {
      root.classList.add("detail-open");
    }
  }

  function selectTopic(topicId, { updateHash = true } = {}) {
    const hit = topicById[topicId];
    if (!hit) return;
    // Keep the same stage panel — only highlight the concept in the checklist.
    selectStage(hit.stage.id, { expand: true, updateHash, topicId });
  }

  function renderDetail(stage, topicId) {
    detailEmpty.hidden = true;
    detailBody.hidden = false;
    root.querySelector("[data-d-title]").textContent = stage.title;
    root.querySelector("[data-d-sub]").textContent = stage.subtitle;
    root.querySelector("[data-d-prereq]").textContent = stage.prerequisite;
    root.querySelector("[data-d-goal]").textContent = stage.goal;
    root.querySelector("[data-d-rec]").textContent = stage.tools.recommended.join(" · ");
    root.querySelector("[data-d-alt]").textContent = stage.tools.alternatives.join(" · ");
    root.querySelector("[data-d-exercise]").textContent = stage.exercise;
    root.querySelector("[data-d-pass]").textContent = stage.passCriteria;
    const docsUl = root.querySelector("[data-d-docs]");
    docsUl.innerHTML = "";
    (stage.docs || []).forEach((d) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = d.url;
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      a.className = "doc-link";
      const title = document.createElement("span");
      title.className = "doc-title";
      title.textContent = d.label;
      const host = document.createElement("span");
      host.className = "doc-url muted tiny";
      host.textContent = d.url.replace(/^https?:\/\//, "");
      a.appendChild(title);
      a.appendChild(host);
      li.appendChild(a);
      docsUl.appendChild(li);
    });
    if (!(stage.docs || []).length) {
      const li = document.createElement("li");
      li.className = "muted";
      li.textContent = "—";
      docsUl.appendChild(li);
    }
    refreshDetailChrome(stage, topicId);
  }

  function refreshDetailChrome(stage, topicId = focusTopicId) {
    root.querySelector("[data-d-track]").textContent = trackLabel[stage.track];
    root.querySelector("[data-d-level]").textContent = stage.essential ? ui.levelEssential : ui.levelOptional;
    const st = getStatus(stage.id);
    const statusEl = root.querySelector("[data-d-status]");
    statusEl.textContent = statusLabel[st];
    statusEl.dataset.state = st;

    root.querySelectorAll("[data-set-status]").forEach((btn) => {
      btn.classList.toggle("active", btn.getAttribute("data-set-status") === st);
    });

    const topicBlock = root.querySelector("[data-topic-status-block]");
    if (topicId && topicById[topicId]) {
      topicBlock.hidden = false;
      const tSt = getTopicStatus(topicId);
      root.querySelector("[data-d-topic-name]").textContent = topicById[topicId].topic.label;
      root.querySelectorAll("[data-set-topic-status]").forEach((btn) => {
        btn.classList.toggle("active", btn.getAttribute("data-set-topic-status") === tSt);
      });
    } else {
      topicBlock.hidden = true;
    }

    const checked = stage.concepts.filter((c) => isTopicChecked(c.id)).length;
    root.querySelector("[data-d-topic-count]").textContent = `${checked}/${stage.concepts.length} ${ui.topicsProgress}`;

    const ul = root.querySelector("[data-d-concepts]");
    ul.innerHTML = "";
    stage.concepts.forEach((c) => {
      const li = document.createElement("li");
      const tSt = getTopicStatus(c.id);
      const on = tSt === "done";
      li.className = "check-item" + (on ? " checked" : "") + (topicId === c.id ? " focus-item" : "");
      li.dataset.state = tSt;
      li.innerHTML = `
        <button type="button" class="check-btn" data-toggle-topic="${c.id}" aria-pressed="${on ? "true" : "false"}">
          <span class="check-box" aria-hidden="true"></span>
          <span class="check-label">${c.label}</span>
          <span class="status-pill tiny-pill">${statusLabel[tSt]}</span>
        </button>
        <div class="branch-actions in-panel" role="group">
          <button type="button" class="mini-status ${tSt === "learning" ? "active" : ""}" data-topic-status="${c.id}" data-status="learning">${ui.markLearning}</button>
          <button type="button" class="mini-status primary ${tSt === "done" ? "active" : ""}" data-topic-status="${c.id}" data-status="done">${ui.markDoneTopic}</button>
          <button type="button" class="mini-status ${tSt === "review" ? "active" : ""}" data-topic-status="${c.id}" data-status="review">${ui.markReview}</button>
        </div>
      `;
      ul.appendChild(li);
    });

    if (topicId) {
      const focusEl = ul.querySelector(`[data-toggle-topic="${topicId}"]`);
      focusEl?.scrollIntoView({ block: "nearest", behavior: reducedMotion() ? "auto" : "smooth" });
    }
  }

  function closeDetail() {
    root.classList.remove("detail-open");
    activeStageId = null;
    focusTopicId = null;
    detailEmpty.hidden = false;
    detailBody.hidden = true;
    closeDetailBtn.hidden = true;
    root.querySelectorAll(".station-main, .branch").forEach((el) => el.classList.remove("active"));
    history.replaceState(null, "", location.pathname + location.search);
  }

  function buildFlatList() {
    flatList.innerHTML = "";
    for (const s of allStages) {
      const li = document.createElement("li");
      li.className = "flat-item";
      li.dataset.station = s.id;
      li.dataset.essential = s.essential ? "1" : "0";
      li.innerHTML = `
        <button type="button" class="flat-btn" data-select-stage="${s.id}">
          <span class="flat-title">${s.title}</span>
          <span class="muted flat-track">${trackLabel[s.track]}</span>
          <span class="status-pill" data-status-for="${s.id}">${statusLabel[getStatus(s.id)]}</span>
        </button>
      `;
      flatList.appendChild(li);
    }
  }

  function setView(next) {
    view = next;
    root.querySelectorAll("[data-view]").forEach((btn) => {
      const on = btn.getAttribute("data-view") === next;
      btn.classList.toggle("active", on);
      btn.setAttribute("aria-pressed", on ? "true" : "false");
    });
    root.querySelector('[data-pane="map"]').hidden = next !== "map";
    root.querySelector('[data-pane="list"]').hidden = next !== "list";
  }

  function matchesSearch(stage, q) {
    if (!q) return true;
    const hay = [
      stage.title,
      stage.titleEn,
      stage.titleFa,
      stage.subtitle,
      ...stage.concepts.flatMap((c) => [c.label, c.labelEn, c.labelFa]),
      ...stage.tools.recommended,
      ...stage.tools.alternatives,
    ]
      .join(" ")
      .toLowerCase();
    return hay.includes(q);
  }

  function applySearchAndFilter() {
    const q = (searchInput.value || "").trim().toLowerCase();
    root.querySelectorAll("[data-station]").forEach((li) => {
      const id = li.getAttribute("data-station");
      const stage = stageById[id];
      if (!stage) return;
      const st = getStatus(id);
      const okFilter =
        filter === "all" ||
        (filter === "done" && st === "done") ||
        (filter === "open" && st !== "done");
      const okSearch = matchesSearch(stage, q);
      li.hidden = !(okFilter && okSearch);
      if (okSearch && q) expandStation(id, true);
    });
  }

  function applyFilter() {
    applySearchAndFilter();
  }

  function continuePath() {
    const next = tracks.main.find((s) => getStatus(s.id) !== "done");
    if (!next) {
      selectStage(tracks.main[tracks.main.length - 1].id);
      return;
    }
    setView("map");
    selectStage(next.id);
    const el = root.querySelector(`.station[data-station="${next.id}"]`);
    el?.scrollIntoView({ behavior: reducedMotion() ? "auto" : "smooth", block: "center" });
  }

  function openFromHash() {
    const hash = decodeURIComponent(location.hash.replace(/^#/, ""));
    if (!hash) return;
    if (stageById[hash]) selectStage(hash, { updateHash: false });
    else if (topicById[hash]) selectTopic(hash, { updateHash: false });
  }

  // Events
  root.addEventListener("click", (e) => {
    const viewBtn = e.target.closest("[data-view]");
    if (viewBtn) {
      setView(viewBtn.getAttribute("data-view"));
      return;
    }
    const filterBtn = e.target.closest("[data-filter]");
    if (filterBtn) {
      filter = filterBtn.getAttribute("data-filter");
      root.querySelectorAll("[data-filter]").forEach((b) => b.classList.toggle("active", b === filterBtn));
      applyFilter();
      return;
    }
    if (e.target.closest("[data-expand-all]")) {
      allStages.forEach((s) => expandStation(s.id, true));
      return;
    }
    if (e.target.closest("[data-collapse-all]")) {
      allStages.forEach((s) => expandStation(s.id, false));
      return;
    }
    if (e.target.closest("[data-continue]")) {
      continuePath();
      return;
    }
    if (e.target.closest("[data-close-detail]")) {
      closeDetail();
      return;
    }
    const topicStatusBtn = e.target.closest("[data-topic-status]");
    if (topicStatusBtn) {
      e.preventDefault();
      e.stopPropagation();
      setTopicStatus(
        topicStatusBtn.getAttribute("data-topic-status"),
        topicStatusBtn.getAttribute("data-status"),
      );
      return;
    }
    const panelTopicStatus = e.target.closest("[data-set-topic-status]");
    if (panelTopicStatus && focusTopicId) {
      setTopicStatus(focusTopicId, panelTopicStatus.getAttribute("data-set-topic-status"));
      return;
    }
    const checkBtn = e.target.closest("[data-toggle-topic]");
    if (checkBtn) {
      const topicId = checkBtn.getAttribute("data-toggle-topic");
      focusTopicId = topicId;
      toggleTopicCheck(topicId);
      return;
    }
    const statusBtn = e.target.closest("[data-set-status]");
    if (statusBtn && activeStageId) {
      // Progress % only cares about stage status — never the sub-topic id.
      setStageStatus(activeStageId, statusBtn.getAttribute("data-set-status"));
      return;
    }
    const topicBtn = e.target.closest("[data-select-topic]");
    if (topicBtn) {
      selectTopic(topicBtn.getAttribute("data-select-topic"));
      return;
    }
    const stageBtn = e.target.closest("[data-select-stage]");
    if (stageBtn) {
      const id = stageBtn.getAttribute("data-select-stage");
      const li = root.querySelector(`.station[data-station="${id}"]`);
      const isOpen = !!li?.classList.contains("open");

      if (view === "map") {
        expandStation(id, !isOpen);
        selectStage(id, { expand: false, topicId: null });
        return;
      }

      selectStage(id, { expand: false });
    }
  });

  searchInput.addEventListener("input", () => {
    applySearchAndFilter();
  });

  window.addEventListener("hashchange", openFromHash);

  buildFlatList();
  paintStatuses();
  updateProgressMeter();
  setView("map");
  openFromHash();
</script>

