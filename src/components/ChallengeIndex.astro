---
import Base from "../layouts/Base.astro";
import { links, t, href, type Lang } from "../data/site";
import { getDays, groups, num, type Edition } from "../lib/challenge";

interface Props {
  lang: Lang;
  edition?: Edition;
}
const { lang, edition = "2026" } = Astro.props;
const days = getDays(lang, edition);
const other: Edition = edition === "2026" ? "2025" : "2026";
const base = edition === "2026" ? "/challenge/" : "/challenge/2025/";
const L = {
  title: { en: "30-Day Android Interview Challenge", fa: "چالش ۳۰ روزهٔ مصاحبهٔ اندروید" },
  edition2026: { en: "2026 Edition · English & Persian", fa: "نسخهٔ ۲۰۲۶ · فارسی و انگلیسی" },
  edition2025: { en: "2025 Edition · English (archive)", fa: "نسخهٔ ۲۰۲۵ · انگلیسی (آرشیو)" },
  lead2026: {
    en: "Thirty rebuilt days from Activity lifecycle to mobile system design. Each day answers interview questions at four levels — Junior, Mid, Senior and Architect — with code, traps and architect notes. Read on the web in English or Persian, or download the PDF carousel.",
    fa: "سی روز بازسازی‌شده از چرخهٔ عمر Activity تا طراحی سیستم موبایل. هر روز به سؤال‌های مصاحبه در چهار سطح جواب می‌دهد — جونیور، مید، سینیور و آرکیتکت — همراه با کد، تله‌ها و نکته‌های آرکیتکت. روی وب بخوانید یا کاروسل PDF را دانلود کنید.",
  },
  lead2025: {
    en: "The original 2025 carousels (PDF). Kept as an archive while the 2026 edition is the default on this site.",
    fa: "کاروسل‌های اصلی ۲۰۲۵ (PDF). به‌عنوان آرشیو نگه داشته شده؛ نسخهٔ پیش‌فرض سایت ۲۰۲۶ است.",
  },
  switchTo2025: { en: "Browse the 2025 archive", fa: "مشاهدهٔ آرشیو ۲۰۲۵" },
  switchTo2026: { en: "Back to 2026 edition", fa: "بازگشت به نسخهٔ ۲۰۲۶" },
  follow: { en: "Follow on LinkedIn", fa: "دنبال کردن در لینکدین" },
  day: { en: "Day", fa: "روز" },
  days: { en: "Days", fa: "روزهای" },
  slides: { en: "slides", fa: "اسلاید" },
  web: { en: "full web notes", fa: "متن کامل وب" },
  walkthrough: { en: "2026 walkthrough", fa: "مرور نسخهٔ ۲۰۲۶" },
  walkthroughCap: {
    en: "A short tour of the web notes, PDF downloads, and the Persian edition.",
    fa: "مرور کوتاه متن وب، دانلود PDF و نسخهٔ فارسی.",
  },
};
const editionLabel = edition === "2026" ? L.edition2026 : L.edition2025;
const lead = edition === "2026" ? L.lead2026 : L.lead2025;
const walkthrough = {
  src: "/video/challenge-2026-walkthrough.mp4",
  poster: "/video/challenge-2026-walkthrough.jpg",
};
---

<Base lang={lang} path={base} title={t(L.title, lang)} description={t(lead, lang)} image={edition === "2026" ? walkthrough.poster : days[0].cover}>
  <section class="section container">
    <div class="section-head wide">
      <span class="eyebrow">{t(editionLabel, lang)}</span>
      <h1>{t(L.title, lang)}</h1>
      <p>{t(lead, lang)}</p>
      <p class="note">
        {
          edition === "2026" ? (
            <>
              <a href={href("/challenge/2025/", lang)} class="arrow">{t(L.switchTo2025, lang)} </a>
              <span class="sep">·</span>
              <a href={links.linkedin} target="_blank" rel="noopener" class="arrow">{t(L.follow, lang)} </a>
            </>
          ) : (
            <a href={href("/challenge/", lang)} class="arrow">{t(L.switchTo2026, lang)} </a>
          )
        }
      </p>
    </div>

    {
      edition === "2026" && (
        <figure class="walkthrough">
          <video
            src={walkthrough.src}
            poster={walkthrough.poster}
            controls
            playsinline
            preload="none"
            title={t(L.walkthrough, lang)}
          ></video>
          <figcaption>
            <strong>{t(L.walkthrough, lang)}</strong>
            <span class="muted"> — {t(L.walkthroughCap, lang)}</span>
          </figcaption>
        </figure>
      )
    }

    {
      groups.map((g) => (
        <section class="group">
          <h2>
            <span class="range">
              {t(L.days, lang)} {num(g.from, lang)}–{num(g.to, lang)}
            </span>
            {g[lang]}
          </h2>
          <div class="days">
            {days
              .filter((d) => d.n >= g.from && d.n <= g.to)
              .map((d) => (
                <a class="day" href={href(`${base}${d.slug}/`, lang)}>
                  <span class="thumb">
                    <img src={d.cover} alt="" loading="lazy" width="480" height="600" />
                  </span>
                  <span class="n">
                    {t(L.day, lang)} {num(d.n, lang)}
                    {edition === "2025"
                      ? `${lang === "fa" ? "، " : " · "}${num(d.slides, lang)} ${t(L.slides, lang)}`
                      : `${lang === "fa" ? "، " : " · "}${t(L.web, lang)}`}
                  </span>
                  <span class="title">{d.title}</span>
                </a>
              ))}
          </div>
        </section>
      ))
    }
  </section>
</Base>

<style>
  .wide {
    max-width: 820px;
  }
  .walkthrough {
    margin: 2rem 0 0.5rem;
    max-width: 420px;
  }
  .walkthrough video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  .walkthrough figcaption {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .walkthrough {
      max-width: 320px;
      margin-inline: auto;
    }
  }
  .note {
    font-size: 1rem !important;
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: 1rem;
  }
  .note a {
    display: inline-block;
    font-weight: 600;
  }
  .sep {
    margin-inline: 0.35rem;
    color: var(--muted);
  }
  .group {
    margin-top: 3rem;
  }
  .group h2 {
    font-size: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }
  .range {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
  .days {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .day {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .day:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .thumb {
    display: block;
    aspect-ratio: 4 / 5;
    background: #eef5f3;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .n {
    font-size: 0.78rem;
    color: var(--muted);
    padding: 0 0.85rem;
  }
  .title {
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.35;
    padding: 0 0.85rem 0.95rem;
  }
</style>
